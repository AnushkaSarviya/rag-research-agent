# API Keys Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

# ── LLM Provider Keys ────────────────────────────────────────────────────────

# Groq API Key (for Groq provider models)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (for OpenRouter provider models and embeddings)
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override default summarizer model
OPEN_ROUTER_SUMMARY_MODEL=meta-llama/llama-3.1-70b-instruct

# Tavily API Key (optional, for web search functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# ── Authentication ────────────────────────────────────────────────────────────

# REQUIRED: Secret key for signing JWTs. Must be a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars-change-this-in-production

# JWT algorithm (HS256 is the default and recommended for simplicity)
JWT_ALGORITHM=HS256

# Token expiry in hours (default 24)
JWT_EXPIRE_HOURS=24

# ── Deployment ────────────────────────────────────────────────────────────────

# Backend URL used by the Streamlit frontend.
# Change to your deployed backend URL in production.
BACKEND_URL=http://127.0.0.1:9999
